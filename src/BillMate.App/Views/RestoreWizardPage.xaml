<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BillMate.ClientCore.ViewModels;assembly=BillMate.ClientCore"
             xmlns:iface="clr-namespace:BillMate.Application.Common.Interfaces;assembly=BillMate.Application"
             xmlns:controls="clr-namespace:BillMate.App.Controls"
             x:Class="BillMate.App.Views.RestoreWizardPage"
             x:DataType="vm:RestoreWizardViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBaseLight}, Dark={StaticResource SurfaceBaseDark}}"
             Shell.NavBarIsVisible="False"
             Title="Backup &amp; Restore">

    <Grid RowDefinitions="Auto,*">
        <!-- 1. Universal Top Navigation Bar -->
        <controls:AppNavBar Grid.Row="0" ActiveTab="Restore" />

        <!-- 2. Restore Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="760" HorizontalOptions="Center">
                
                <!-- Page Title & Status Subtitle -->
                <Label Text="💾 Backup &amp; Disaster Recovery" Style="{StaticResource PageTitleStyle}" />
                <Label Text="{Binding StatusSubtitle}"
                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />

                <!-- Success Toast Card -->
                <Border BackgroundColor="#064E3B" Stroke="#059669" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14"
                        IsVisible="{Binding ToastMessage, Converter={StaticResource IsNotNullConverter}}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="✅" FontSize="20" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding ToastMessage}" TextColor="#ECFDF5" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Error Alert Card -->
                <Border BackgroundColor="#4C0519" Stroke="#E11D48" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14"
                        IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="⚠️" FontSize="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding ErrorCode, StringFormat='Notice ({0}):'}" TextColor="#FFE4E6" FontSize="12" FontAttributes="Bold" />
                            <Label Text="{Binding ErrorMessage}" TextColor="#FFF1F2" FontSize="14" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Loading Spinner Card -->
                <Border Style="{StaticResource BentoCardBorder}" IsVisible="{Binding IsLoading}">
                    <HorizontalStackLayout Spacing="16" HorizontalOptions="Center" VerticalOptions="Center" Padding="12">
                        <ActivityIndicator IsRunning="{Binding IsLoading}" Color="#2563EB" />
                        <Label Text="Processing backup or database restore... Please wait." FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Action Bar: Create Backup Now & Refresh Backups -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0" Text="💾 Create Local Backup Now" Style="{StaticResource PrimaryActionButton}"
                            BackgroundColor="#10B981" TextColor="#FFFFFF"
                            Command="{Binding CreateLocalBackupCommand}" />
                    <Button Grid.Column="1" Text="🔄 Refresh Backups" Style="{StaticResource PrimaryActionButton}"
                            BackgroundColor="#2563EB" TextColor="#FFFFFF"
                            Command="{Binding LoadBackupsCommand}" />
                </Grid>

                <!-- Step 2: Confirmation Box (Shown when a backup is selected) -->
                <Border BackgroundColor="#451A03" Stroke="#D97706" StrokeThickness="2" StrokeShape="RoundRectangle 16" Padding="20"
                        IsVisible="{Binding SelectedBackup, Converter={StaticResource IsNotNullConverter}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="⚠️ Confirm Database Restore" FontSize="18" FontAttributes="Bold" TextColor="#FEF3C7" />
                        <Label Text="{Binding SelectedBackup.FileName, StringFormat='Selected: {0}'}" FontSize="15" FontAttributes="Bold" TextColor="#FFFFFF" />
                        <Label Text="Restoring will replace the current active shop database with this snapshot. Any bills created after this snapshot will be overwritten."
                               TextColor="#FDE68A" FontSize="13" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                            <Button Grid.Column="0" Text="Restore Database Now" Style="{StaticResource PrimaryActionButton}"
                                    BackgroundColor="#DC2626" TextColor="#FFFFFF"
                                    Command="{Binding ExecuteRestoreCommand}" />
                            <Button Grid.Column="1" Text="Cancel" Style="{StaticResource PrimaryActionButton}"
                                    BackgroundColor="#27272A" TextColor="#E2E8F0"
                                    Command="{Binding CancelConfirmationCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Backups List Section -->
                <Label Text="Available Database Snapshots" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" />

                <!-- Empty State -->
                <Border Style="{StaticResource BentoCardBorder}" IsVisible="{Binding IsEmpty}">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Padding="24">
                        <Label Text="📂 No Backup Snapshots Found" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="Click 'Create Local Backup Now' above to take an instant safe snapshot of your shop database."
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Collection of Backups -->
                <CollectionView ItemsSource="{Binding AvailableBackups}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="iface:DriveBackupFileDto">
                            <Border Style="{StaticResource BentoCardBorder}" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding FileName}" FontSize="15" FontAttributes="Bold" />
                                        <HorizontalStackLayout Spacing="14">
                                            <Label Text="{Binding CreatedAtUtc, StringFormat='📅 {0:dd MMM yyyy, hh:mm tt}'}" FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                            <Label Text="{Binding SizeBytes, StringFormat='📦 {0:N0} bytes'}" FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="Restore" Style="{StaticResource PrimaryActionButton}"
                                            BackgroundColor="#2563EB" TextColor="#FFFFFF" HeightRequest="44"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RestoreWizardViewModel}}, Path=ProceedToConfirmationCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
