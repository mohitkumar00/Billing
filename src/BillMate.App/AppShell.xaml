<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:BillMate.App.Views"
       x:Class="BillMate.App.AppShell"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.BackgroundColor="#09090B"
       Shell.ForegroundColor="#FFFFFF"
       Shell.TitleColor="#FFFFFF"
       Title="BillMate Retail POS &amp; Billing">

    <FlyoutItem Route="dashboard">
        <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Route="pos">
        <ShellContent ContentTemplate="{DataTemplate views:PosPage}" />
    </FlyoutItem>

    <FlyoutItem Route="inventory">
        <ShellContent ContentTemplate="{DataTemplate views:InventoryPage}" />
    </FlyoutItem>

    <FlyoutItem Route="reports">
        <ShellContent ContentTemplate="{DataTemplate views:ReportsPage}" />
    </FlyoutItem>

    <FlyoutItem Route="restore">
        <ShellContent ContentTemplate="{DataTemplate views:RestoreWizardPage}" />
    </FlyoutItem>

    <FlyoutItem Route="pinlogin">
        <ShellContent ContentTemplate="{DataTemplate views:PinLoginPage}" />
    </FlyoutItem>

</Shell>
